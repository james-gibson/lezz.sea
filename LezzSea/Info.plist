<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Bonjour discovery of _adhd-isotope._tcp triggers the local network
	     privacy prompt on macOS 15 and later. _smoke-alarm._tcp is the lab
	     channel: the alarm advertises the health port it actually bound, and
	     the rotated isotope name is what tells two members apart. Both keys
	     are required: the purpose string explains the prompt, and the service
	     list declares exactly what the app browses. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>lezz.sea looks for adhd clusters and smoke-alarm lab clusters announced with Bonjour on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_adhd-isotope._tcp</string>
		<string>_smoke-alarm._tcp</string>
	</array>

	<!-- The app speaks HTTP/JSON to a cluster on loopback or the lab LAN. It
	     implements no cryptography of its own. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
